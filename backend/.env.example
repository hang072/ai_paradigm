# 后端服务端口
PORT=8001

# LLM 配置(留空则跑 mock,S2a 行为)
# 支持任意 OpenAI-compatible 端点:DeepSeek / Kimi / Qwen / OpenAI / Ollama 均可
#
# DeepSeek 示例:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# OpenAI 示例(留空 BASE_URL):
#   LLM_MODEL=gpt-4o-mini
#
# 通义千问示例:
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# Embedding 配置(阶段 5 续 3 —— 知识库向量检索, Milvus 必填, 否则 server 启动失败)
# 走与 chat 同一 OpenAI-compatible 端点, LLM_API_KEY / LLM_BASE_URL 复用
# 常见可用模型 + 维数(后端硬编码):
#   text-embedding-3-small  1536  (OpenAI)
#   text-embedding-3-large  3072  (OpenAI)
#   text-embedding-v3       1536  (通义千问 DashScope)
#   embedding-v2            1024  (智源 BGE)
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Embedding 专用配置(可选)—— 当 LLM 端点不支持 /v1/embeddings 时,
# 单独指定一个支持 embedding 的 OpenAI 兼容端点。留空则复用 chat 的。
#
# 阿里云百炼(推荐,免费):
#   URL:    https://dashscope.aliyuncs.com/compatible-mode/v1
#   model:  text-embedding-v3  (1536 维,免费)
#   key:    申请 https://bailian.console.aliyun.com → API-Key
# LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_EMBEDDING_API_KEY=sk-...
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=

# Vision / OCR 配置(阶段 5 续 4)—— PDF 上传先走 VLM 提取原文
# 走与 chat 同一 OpenAI 兼容端点, 不再单独 endpoint
# 常用模型:
#   qwen3-vl-32b-instruct  (中文友好, 通义千问)
# 留空 = 不启用 vision, PDF fallback 到 ledongthuc 文本抽取(中文 PDF 会乱码)
LLM_VISION_MODEL=qwen3-vl-32b-instruct

# Vision (Qwen-VL) HTTP timeout, 默认 300 秒(5 分钟)。
# 多页 PDF (10+ 页) 在中转 provider 上偶发 2 分钟 timeout,
# 调到 300s + 1 次 retry 后基本不失败。 设 0 = 走默认 300s。
#PARADIGM_VISION_TIMEOUT_SEC=300

# PDF → PNG 工具路径(Poppler 的 pdftoppm.exe)。Windows 必装:
#   下载 https://github.com/oschwartz10612/poppler-windows/releases
#   解压后把 poppler-24.08.0/Library/bin 加到 PATH, 或在下面设完整路径
#   Mac:    brew install poppler
#   Linux:  apt install poppler-utils
PDFTOPPM_PATH=

# Milvus 服务地址(独立 Milvus, 不是 Lite 模式; Go SDK v2 不支持 Lite)
# 启 Milvus: cd backend && docker compose -f docker-compose.yml up -d
# 默认端口 19530
MILVUS_ADDRESS=localhost:19530

# PubMed 文献检索(NCBI E-utilities)
# 留空则 search_literature / verify_reference / 任务流 enrich 的 PubMed 检索不启用,
# 会如实说明"未启用",绝不伪造 PMID/期刊卷期。
#   PUBMED_EMAIL   必填才启用(NCBI 要求附带联系邮箱以便告知用途)
#   PUBMED_API_KEY 可选;有则速率上限 10 req/s,无则 3 req/s
PUBMED_EMAIL=
PUBMED_API_KEY=
